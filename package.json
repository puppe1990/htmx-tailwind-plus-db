{
  "name": "htmx-turso-starter",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node src/server.mjs",
    "new": "node scripts/new.mjs",
    "seed": "node scripts/seed.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "ci": "npm run format:check && npm run lint && npm test",
    "badge-off": "node scripts/disable-badge.mjs",
    "deploy": "npm run badge-off && netlify deploy --prod",
    "prepare": "husky"
  },
  "dependencies": {
    "@libsql/client": "^0.15.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.9.8",
    "vitest": "^3.2.4"
  },
  "lint-staged": {
    "*.{mjs,js}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,html,md,toml,yml,yaml}": [
      "prettier --write"
    ]
  }
}
