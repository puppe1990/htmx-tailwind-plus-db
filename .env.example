# Copy to .env (gitignored) to override the local dev defaults.
#   cp .env.example .env
# `npm run dev` loads .env automatically when present.

# Shared login password. Dev default when unset: demo1234.
APP_PASSWORD=

# Secret used to sign the session cookie.
# Generate one with: openssl rand -hex 32
SESSION_SECRET=

# Persistence. Leave blank locally to use the SQLite file src/data/items.db.
# Production (Netlify) uses a Turso libsql:// URL plus an auth token.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
